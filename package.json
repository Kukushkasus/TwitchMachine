{
  "name": "donation-bot",
  "version": "1.0.0",
  "description": "DonationAlerts -> Twitch chat bot with bad-word filtering",
  "main": "src/index.js",
  "bin": "src/index.js",
  "scripts": {
    "start": "node src/index.js",
    "bundle": "esbuild src/index.js --bundle --platform=node --target=node18 --format=cjs --outfile=dist/bundle.js --external:bufferutil --external:utf-8-validate",
    "build": "npm run bundle && pkg dist/bundle.js --targets node18-win-x64 --output build/donation-bot.exe"
  },
  "pkg": {
    "targets": [
      "node18-win-x64"
    ],
    "outputPath": "build"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@donation-alerts/api": "^4.0.0",
    "@donation-alerts/auth": "^4.0.0",
    "@donation-alerts/events": "^4.0.0",
    "leo-profanity": "^1.9.0",
    "russian-bad-word-censor": "^2.1.8",
    "tmi.js": "^1.8.5",
    "ws": "^8.21.3"
  },
  "devDependencies": {
    "esbuild": "^0.28.2",
    "pkg": "^5.8.1"
  }
}
